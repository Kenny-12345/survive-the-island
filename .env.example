# Server port
PORT=3001
# Optional PostgreSQL / Supabase connection string. If unset, profiles are stored in data/db.json
DATABASE_URL=
# Comma-separated allowed origins for Socket.IO in production (frontend host). Leave empty to allow same-origin only + localhost dev.
CORS_ORIGINS=
# Frontend: URL of the backend when hosted separately (e.g. Vercel frontend + Render backend)
VITE_SERVER_URL=
