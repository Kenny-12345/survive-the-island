{
  "name": "Survive The Island server",
  "containerEnv": {
    "PORT": "3001",
    "CORS_ORIGINS": "https://survive-the-island-rho.vercel.app"
  },
  "forwardPorts": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "game server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci --no-audit --no-fund",
  "postStartCommand": "bash scripts/codespace-start.sh > /tmp/start.log 2>&1",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": false
}
